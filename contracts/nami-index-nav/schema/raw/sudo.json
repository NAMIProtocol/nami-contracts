{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SudoMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "update_fees"
      ],
      "properties": {
        "update_fees": {
          "type": "object",
          "required": [
            "fees"
          ],
          "properties": {
            "fee_collector": {
              "type": [
                "string",
                "null"
              ]
            },
            "fees": {
              "$ref": "#/definitions/FeeRates"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "update_allocation"
      ],
      "properties": {
        "update_allocation": {
          "type": "object",
          "required": [
            "target_allocation"
          ],
          "properties": {
            "target_allocation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AssetAllocation_for_OracleConfig"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "AssetAllocation_for_OracleConfig": {
      "type": "object",
      "required": [
        "denom",
        "oracle",
        "slippage",
        "threshold",
        "weight"
      ],
      "properties": {
        "denom": {
          "type": "string"
        },
        "oracle": {
          "$ref": "#/definitions/OracleConfig"
        },
        "slippage": {
          "$ref": "#/definitions/Decimal"
        },
        "swap_contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold": {
          "$ref": "#/definitions/Decimal"
        },
        "weight": {
          "$ref": "#/definitions/Decimal"
        }
      },
      "additionalProperties": false
    },
    "Decimal": {
      "description": "A fixed-point decimal value with 18 fractional digits, i.e. Decimal(1_000_000_000_000_000_000) == 1.0\n\nThe greatest possible value that can be represented is 340282366920938463463.374607431768211455 (which is (2^128 - 1) / 10^18)",
      "type": "string"
    },
    "FeeRates": {
      "description": "Configuration of optional fee rates.\n\n- `management`: annualized fee rate (e.g., 0.02 for 2% per year) - `performance`: performance fee rate applied to gains above the high‐water mark - `transaction`: fee rate applied to each transaction",
      "type": "object",
      "properties": {
        "management": {
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "performance": {
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "transaction": {
          "anyOf": [
            {
              "$ref": "#/definitions/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Layer1Asset": {
      "type": "object",
      "required": [
        "chain",
        "symbol"
      ],
      "properties": {
        "chain": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "OracleConfig": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "layer1"
          ],
          "properties": {
            "layer1": {
              "$ref": "#/definitions/Layer1Asset"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
