    },
    {
      "type": "object",
      "required": [
        "add_allocation"
      ],
      "properties": {
        "add_allocation": {
          "type": "object",
          "required": [
            "contract",
            "denom"
          ],
          "properties": {
            "contract": {
              "type": "string"
